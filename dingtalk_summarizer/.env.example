# ===== Claude / Anthropic =====
# 在 https://console.anthropic.com 获取 API Key
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# 可选：覆盖默认模型（默认 claude-opus-4-8）
# DINGTALK_SUMMARY_MODEL=claude-opus-4-8

# ===== DingTalk Workspace CLI (dws) =====
# 不需要在这里配置凭证。dws 通过 `dws auth login` 完成 OAuth 登录，
# 凭证由 dws 自行加密存储在 ~/.dws/ 中，不落盘明文。
